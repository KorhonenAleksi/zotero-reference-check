pref-style-title = Reference style
pref-style-description = Decides which details “Fill missing details” treats as missing. Filling a field a style doesn't print does no harm.
pref-style-apa =
    .label = APA 7
pref-style-chicago =
    .label = Chicago (also needs the place of publication for books, chapters and reports)
pref-clean-title = Clean up references
pref-clean-description = Each rule can be switched off. Every change is still listed for confirmation first.
pref-clean-databaseLinks =
    .label = Remove database, library proxy and academic network links (items without a DOI)
pref-clean-archiveScans =
    .label = Move Internet Archive book scan links to a link attachment (books and chapters without a DOI)
pref-clean-databaseFields =
    .label = Clear database names (Archive) and accession numbers (Loc. in Archive)
pref-clean-journalNames =
    .label = Remove publisher and coverage suffixes from journal names
pref-clean-pages =
    .label = Clear page “0” and article IDs in Pages
pref-clean-volumeIssue =
    .label = Move an issue stored in Volume, such as “44(6)”, to Issue
pref-clean-extraFields =
    .label = Fix page counts and DOIs stored in Extra
pref-clean-catalogueNames =
    .label = Fix catalogue-style book titles (“; a subtitle”) and creator names (“with an introduction by …”)
pref-clean-shortDois =
    .label = Replace short DOIs (10/abc) with the full DOI
pref-privacy-title = What is sent where
pref-privacy-description = Short DOIs are sent to doi.org. “Fill missing details” sends DOIs, or titles, first authors and years, to Crossref (api.crossref.org), and books' ISBNs to Open Library (openlibrary.org). Nothing else leaves your computer, and nothing is sent until you run a command.
